# Block Master docker compose settings. Copy to .env and fill in. NEVER commit .env.
# On myNode, mynode/install-mynode.sh writes this file for you (/mnt/hdd/mynode/blockmaster/blockmaster.env).

# --- your Bitcoin Core node (RPC) ---
CORE_RPC_HOST=host.docker.internal   # the Docker host; bitcoind must allow the Docker subnet (rpcallowip=172.16.0.0/12 on myNode)
CORE_RPC_PORT=8332
CORE_RPC_USERNAME=mynode             # myNode's RPC user; password is in /mnt/hdd/mynode/settings/.btcrpcpw
CORE_RPC_PASSWORD=change-me

# --- your Electrum server (electrs / Fulcrum) for address lookups ---
MEMPOOL_BACKEND=electrum             # electrum (recommended) | none (Bitcoin Core only: no address pages)
ELECTRUM_HOST=host.docker.internal
ELECTRUM_PORT=50001
ELECTRUM_TLS_ENABLED=false

# --- database (local MariaDB container) ---
DB_PASSWORD=change-me-too
DB_ROOT_PASSWORD=change-me-three

# --- web ---
BLOCKMASTER_PORT=4090                # http://<host>:4090
BLOCKMASTER_BIND=0.0.0.0             # 127.0.0.1 to keep it local-only
BLOCKMASTER_DATA=./data-docker       # cache + mysql (must be writable by BLOCKMASTER_UID)
# BLOCKMASTER_UID=1000
# BLOCKMASTER_GID=1000
# BLOCKMASTER_IMAGE=blockmaster/frontend:2.0.0
# HISTORICAL_PRICE=true              # fiat prices come from your backend's price feed
# MINING_DASHBOARD=true
